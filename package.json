{
  "name": "vue-compiler",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "test:prepare": "cargo xtask sync-official-tests --locked && cargo xtask prepare-runtime-smoke",
    "test": "pnpm run test:prepare && cargo test --workspace",
    "test:napi": "cargo xtask verify-napi",
    "test:napi-alias": "cargo xtask verify-napi-alias",
    "test:napi-api": "cargo xtask verify-napi-api",
    "test:napi-platform": "cargo xtask verify-napi-platform",
    "test:wasm": "cargo xtask verify-wasm",
    "test:wasm-browser": "cargo xtask verify-wasm-browser",
    "test:wasm-wasi": "cargo xtask verify-wasm-wasi",
    "conformance": "cargo xtask run-conformance --all"
  }
}
